<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF2F4"
    android:orientation="vertical">

    <!-- toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#953553"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="   Baggage Fee Calculator"
        app:subtitle="    Smart Excess Baggage Fee Calculator"
        app:titleTextColor="#FFFFFF"
        app:subtitleTextColor="#BF8597"
        app:logo="@drawable/round_airplane_ticket_24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- about application -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="About Application"
                android:textColor="#591F31"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:text="Baggage Fee Calculator is a mobile application that was developed and designed for estimating excess baggage fee for air travel based on baggage weight, ticket class and excess baggage rate."
                android:textColor="#4A333A"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#E8D5DA" />

            <!-- instruction -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="How to Use"
                android:textColor="#591F31"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="6dp"
                android:text="1. Enter your baggage weight in kilograms.\n2. Select Economy or Business class.\n3. Enter the excess baggage rate per kg.\n4. Tap Calculate to view the results."
                android:textColor="#4A333A"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#E8D5DA" />

            <!-- developer information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Developer Information"
                android:textColor="#591F31"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="6dp"
                android:text="Name: NUR MUNIRAH BINTI MOHD RAMADZAN\nStudent ID: 2024444018\nGroup: RCDCS2515A\nProgramme Code: CS251"
                android:textColor="#4A333A"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#E8D5DA" />

            <!-- link -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Application Website"
                android:textColor="#591F31"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGithubLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:autoLink="web"
                android:fontFamily="sans-serif-medium"
                android:linksClickable="true"
                android:text="Visit Baggage Fee Calculator on GitHub (https://github.com/Munirah12/Baggage_Fee_Calculator.git)"
                android:textColor="#953553"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- copyright statement -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:text="© 2026 Baggage Fee Calculator. All Rights Reserved."
                android:textColor="#BF8597"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>