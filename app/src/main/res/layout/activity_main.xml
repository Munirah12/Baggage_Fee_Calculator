<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF2F4"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/my_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="#953553"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="   Baggage Fee Calculator"
        app:subtitle="    Smart Excess Baggage Fee Calculator"
        app:titleTextColor="#FFFFFF"
        app:subtitleTextColor="#BF8597"
        app:logo="@drawable/round_airplane_ticket_24"
        />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/my_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Helpful Notice: "
                android:textColor="#591F31"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/noticeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:text="Economy allowance: 20 kg | Business allowance: 40 kg.\nAn additional 8% service tax applies to excess baggage charges."
                android:textColor="#4A333A"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="#E8D5DA" />

            <TextView
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Enter Baggage Weight (kg)"
                android:textColor="#591F31"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inWeight"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/editbox_background"
                android:hint="e.g. 25"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp"
                android:textColor="#591F31"
                android:textColorHint="#8A5A68" />

            <TextView
                android:id="@+id/etClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Choose Ticket Class"
                android:textColor="#591F31"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTicketClass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioEconomy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#953553"
                    android:checked="true"
                    android:fontFamily="sans-serif"
                    android:text="Economy (20 kg)"
                    android:textColor="#4A333A" />

                <RadioButton
                    android:id="@+id/radioBusiness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#953553"
                    android:fontFamily="sans-serif"
                    android:text="Business (40 kg)"
                    android:textColor="#4A333A" />

            </RadioGroup>

            <TextView
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Enter Excess Baggage Rate (RM/kg)"
                android:textColor="#591F31"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inRate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@android:drawable/editbox_background"
                android:hint="e.g. 15"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:textSize="14sp"
                android:textColor="#591F31"
                android:textColorHint="#8A5A68" />

            <Button
                android:id="@+id/btCalculate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#953553"
                android:fontFamily="sans-serif-medium"
                android:text="Calculate"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="#E8D5DA" />

            <TextView
                android:id="@+id/results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Calculation Results"
                android:textColor="#591F31"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/otWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Excess Baggage Weight: 0.00 kg"
                android:textColor="#4A333A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/otCharge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="Excess Baggage Charge: RM 0.00"
                android:textColor="#4A333A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/otTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Total Amount Payable: RM 0.00"
                android:textColor="#953553"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>